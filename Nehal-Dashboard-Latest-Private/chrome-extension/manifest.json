{
  "manifest_version":3,
  "name":"Nehal WhatsApp Project Sync",
  "version":"2.1.0",
  "description":"يرسل الرسائل الجديدة من محادثات WhatsApp Web المختارة إلى لوحة متابعة نهال.",
  "permissions":["storage","activeTab","scripting"],
  "host_permissions":["https://web.whatsapp.com/*","https://nehal-work-status.pm-gala.chatgpt.site/*"],
  "content_scripts":[{"matches":["https://web.whatsapp.com/*"],"js":["config.js","content.js"],"run_at":"document_idle"}],
  "action":{"default_title":"ربط المحادثة بالمشروع","default_popup":"popup.html"}
}
